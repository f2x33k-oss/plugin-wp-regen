{
  "name": "core-app-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Core application for content generation and orchestration",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:workers\"",
    "dev:api": "pnpm --filter @core/api dev",
    "dev:workers": "pnpm --filter @core/workers dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @core/db generate",
    "db:push": "pnpm --filter @core/db push",
    "db:migrate": "pnpm --filter @core/db migrate",
    "db:seed": "pnpm --filter @core/db seed",
    "docker:dev": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:clean": "docker-compose down -v"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "concurrently": "^8.2.2",
    "prettier": "^3.2.4",
    "turbo": "^1.12.0",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}
