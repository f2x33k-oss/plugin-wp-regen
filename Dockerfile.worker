# Dockerfile for Workers

FROM node:20-alpine AS base

# Install pnpm
RUN npm install -g pnpm@8.15.0

WORKDIR /app

# Copy package files
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY apps/workers/package.json ./apps/workers/
COPY packages/db/package.json ./packages/db/
COPY packages/types/package.json ./packages/types/
COPY packages/shared/package.json ./packages/shared/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source code
COPY apps/workers ./apps/workers
COPY packages ./packages
COPY turbo.json ./

# Generate Prisma client
RUN pnpm --filter @core/db generate

# Build packages
RUN pnpm --filter @core/types build
RUN pnpm --filter @core/shared build

# Development stage
FROM base AS development
CMD ["pnpm", "--filter", "@core/workers", "dev"]

# Production build stage
FROM base AS builder
RUN pnpm --filter @core/workers build

# Production stage
FROM node:20-alpine AS production

RUN npm install -g pnpm@8.15.0

WORKDIR /app

# Copy built files
COPY --from=builder /app/apps/workers/dist ./apps/workers/dist
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/workers/package.json ./apps/workers/

CMD ["node", "apps/workers/dist/index.js"]
