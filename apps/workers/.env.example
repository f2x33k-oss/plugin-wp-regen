# Copy this file to .env and fill in your values

NODE_ENV=development

DATABASE_URL=postgresql://core_user:core_password@localhost:5432/core_db

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

WORKER_CONCURRENCY=5
WORKER_ID=worker-1

# External API Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

LOG_LEVEL=info
LOG_FORMAT=pretty
