// ============================================
// CORE APP - Prisma Schema
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USERS & AUTHENTICATION
// ============================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  passwordHash String @map("password_hash")
  fullName  String?  @map("full_name")
  role      UserRole @default(USER)
  status    UserStatus @default(ACTIVE)
  
  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  lastLoginAt DateTime? @map("last_login_at")
  
  // Quotas
  monthlyJobQuota Int @default(100) @map("monthly_job_quota")
  monthlyJobsUsed Int @default(0) @map("monthly_jobs_used")
  quotaResetDate DateTime? @map("quota_reset_date")
  
  // Metadata
  metadata Json @default("{}")
  
  // Relations
  apiKeys    ApiKey[]
  oauthTokens OAuthToken[]
  jobs       Job[]
  contentItems ContentItem[]
  apiCalls   ApiCall[]
  apiCostSummaries ApiCostSummary[]
  userPermissions UserPermission[]
  
  @@index([email])
  @@index([status])
  @@map("users")
}

enum UserRole {
  ADMIN
  USER
  VIEWER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model ApiKey {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  keyHash   String   @unique @map("key_hash")
  keyPrefix String   @map("key_prefix")
  name      String?
  scopes    Json     @default("[]")
  status    ApiKeyStatus @default(ACTIVE)
  
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([keyHash])
  @@map("api_keys")
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model OAuthToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  provider  String
  accessTokenEncrypted  String @map("access_token_encrypted")
  refreshTokenEncrypted String? @map("refresh_token_encrypted")
  tokenType String?   @map("token_type")
  expiresAt DateTime? @map("expires_at")
  scopes    Json      @default("[]")
  
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, provider])
  @@index([userId])
  @@map("oauth_tokens")
}

// ============================================
// JOBS & WORKFLOW
// ============================================

model Job {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  status    JobStatus @default(PENDING)
  priority  Int      @default(0)
  
  // Timing
  createdAt DateTime @default(now()) @map("created_at")
  startedAt DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  estimatedDurationSeconds Int? @map("estimated_duration_seconds")
  
  // Input/Output
  inputParams Json @map("input_params")
  resultData  Json? @map("result_data")
  errorMessage String? @map("error_message")
  errorStack   String? @map("error_stack")
  
  // Progress
  progressPercent Int @default(0) @map("progress_percent")
  currentStep     String? @map("current_step")
  stepsTotal      Int @default(1) @map("steps_total")
  stepsCompleted  Int @default(0) @map("steps_completed")
  
  // Cost
  totalCostUsd Decimal @default(0) @map("total_cost_usd") @db.Decimal(10, 4)
  
  // Metadata
  metadata Json @default("{}")
  
  // Relations
  user User @relation(fields: [userId], references: [id])
  jobSteps JobStep[]
  contentItem ContentItem?
  apiCalls ApiCall[]
  
  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([createdAt(sort: Desc)])
  @@map("jobs")
}

enum JobStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  RETRYING
}

model JobStep {
  id        String   @id @default(uuid())
  jobId     String   @map("job_id")
  stepName  String   @map("step_name")
  stepOrder Int      @map("step_order")
  status    JobStepStatus @default(PENDING)
  
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  
  inputData   Json? @map("input_data")
  outputData  Json? @map("output_data")
  errorMessage String? @map("error_message")
  
  costUsd Decimal @default(0) @map("cost_usd") @db.Decimal(10, 4)
  
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  apiCalls ApiCall[]
  
  @@index([jobId])
  @@index([jobId, stepOrder])
  @@map("job_steps")
}

enum JobStepStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ============================================
// CONTENT
// ============================================

model ContentItem {
  id        String   @id @default(uuid())
  jobId     String   @unique @map("job_id")
  userId    String   @map("user_id")
  contentType String @map("content_type")
  
  // Content
  title    String?
  subtitle String?
  bodyHtml String? @map("body_html")
  bodyMarkdown String? @map("body_markdown")
  
  // Format-specific data
  formatData Json @map("format_data")
  
  // Media
  featuredImageUrl String? @map("featured_image_url")
  mediaUrls Json @default("[]") @map("media_urls")
  
  // Publication
  publishedTo Json @default("[]") @map("published_to")
  
  // SEO
  seoTitle String? @map("seo_title")
  seoDescription String? @map("seo_description")
  keywords Json @default("[]")
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  job Job @relation(fields: [jobId], references: [id])
  user User @relation(fields: [userId], references: [id])
  
  @@index([userId])
  @@index([contentType])
  @@index([createdAt(sort: Desc)])
  @@map("content_items")
}

// ============================================
// API USAGE & COST TRACKING
// ============================================

model ApiCall {
  id        String   @id @default(uuid())
  jobId     String?  @map("job_id")
  jobStepId String?  @map("job_step_id")
  userId    String   @map("user_id")
  
  // API info
  provider String
  endpoint String?
  method   String?
  
  // Tokens
  requestTokens  Int? @map("request_tokens")
  responseTokens Int? @map("response_tokens")
  totalTokens    Int? @map("total_tokens")
  
  // Cost
  costUsd Decimal @map("cost_usd") @db.Decimal(10, 6)
  
  // Status
  statusCode Int? @map("status_code")
  success    Boolean @default(true)
  errorMessage String? @map("error_message")
  
  // Timing
  durationMs Int? @map("duration_ms")
  calledAt   DateTime @default(now()) @map("called_at")
  
  // Metadata
  metadata Json @default("{}")
  
  job Job? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  jobStep JobStep? @relation(fields: [jobStepId], references: [id], onDelete: SetNull)
  user User @relation(fields: [userId], references: [id])
  
  @@index([jobId])
  @@index([userId])
  @@index([provider])
  @@index([calledAt(sort: Desc)])
  @@map("api_calls")
}

model ApiCostSummary {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  provider  String
  
  // Period
  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date
  
  // Metrics
  totalCalls Int @default(0) @map("total_calls")
  totalCostUsd Decimal @default(0) @map("total_cost_usd") @db.Decimal(10, 2)
  totalTokens Int @default(0) @map("total_tokens")
  
  createdAt DateTime @default(now()) @map("created_at")
  
  user User @relation(fields: [userId], references: [id])
  
  @@unique([userId, provider, periodStart, periodEnd])
  @@index([userId])
  @@index([periodStart, periodEnd])
  @@map("api_cost_summaries")
}

// ============================================
// PERMISSIONS
// ============================================

model Permission {
  id       String @id @default(uuid())
  role     String
  resource String
  action   String
  
  userPermissions UserPermission[]
  
  @@unique([role, resource, action])
  @@map("permissions")
}

model UserPermission {
  id           String @id @default(uuid())
  userId       String @map("user_id")
  permissionId String @map("permission_id")
  
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  
  @@unique([userId, permissionId])
  @@map("user_permissions")
}

// ============================================
// SYSTEM & DIAGNOSTICS
// ============================================

model SystemEvent {
  id        String   @id @default(uuid())
  eventType String   @map("event_type")
  severity  EventSeverity
  
  userId String? @map("user_id")
  jobId  String? @map("job_id")
  
  message    String
  stackTrace String? @map("stack_trace")
  metadata   Json @default("{}")
  
  createdAt DateTime @default(now()) @map("created_at")
  
  @@index([eventType])
  @@index([severity])
  @@index([createdAt(sort: Desc)])
  @@map("system_events")
}

enum EventSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

model WorkerHealth {
  id         String   @id @default(uuid())
  workerId   String   @unique @map("worker_id")
  workerType String   @map("worker_type")
  status     WorkerStatus @default(IDLE)
  currentJobId String? @map("current_job_id")
  
  // Stats
  jobsProcessed Int @default(0) @map("jobs_processed")
  lastHeartbeatAt DateTime @default(now()) @map("last_heartbeat_at")
  startedAt DateTime @default(now()) @map("started_at")
  
  // Resources
  cpuPercent Decimal? @map("cpu_percent") @db.Decimal(5, 2)
  memoryMb   Int? @map("memory_mb")
  
  metadata Json @default("{}")
  
  @@index([status])
  @@index([lastHeartbeatAt])
  @@map("worker_health")
}

enum WorkerStatus {
  IDLE
  BUSY
  ERROR
  OFFLINE
}
