# ============================================
# CORE APP - Environment Variables Template
# ============================================

# Node Environment
NODE_ENV=development # development | production | test

# ============================================
# API SERVER
# ============================================
API_PORT=3000
API_HOST=0.0.0.0
API_BASE_URL=http://localhost:3000

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================
# DATABASE (PostgreSQL)
# ============================================
DATABASE_URL=postgresql://core_user:core_password@localhost:5432/core_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ============================================
# REDIS (Queue & Cache)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# JWT (Authentication)
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d
JWT_ALGORITHM=HS256

# ============================================
# API KEYS (External Services)
# ============================================

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_ORGANIZATION_ID=

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Google APIs
GOOGLE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Scraping Service (example: ScrapingBee, ScraperAPI)
SCRAPING_API_KEY=
SCRAPING_API_URL=https://api.scrapingbee.com/v1

# Social Media APIs
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TWITTER_API_KEY=
TWITTER_API_SECRET=

# ============================================
# STORAGE (S3 Compatible)
# ============================================
STORAGE_TYPE=s3 # s3 | minio | local
STORAGE_BUCKET=core-app-assets
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT= # leave empty for AWS S3, set for MinIO
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=https://assets.example.com

# ============================================
# SECRETS VAULT (Optional - HashiCorp Vault)
# ============================================
VAULT_ENABLED=false
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=
VAULT_NAMESPACE=

# ============================================
# WORKERS
# ============================================
WORKER_CONCURRENCY=5
WORKER_MAX_JOBS_PER_WORKER=10

# Job Timeouts (in milliseconds)
JOB_TIMEOUT_DEFAULT=1800000 # 30 minutes
JOB_TIMEOUT_AI_HEAVY=3600000 # 60 minutes

# Retry Configuration
JOB_MAX_ATTEMPTS=3
JOB_RETRY_DELAY=60000 # 1 minute
JOB_RETRY_BACKOFF=exponential # exponential | fixed

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=60000 # 1 minute
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_ENABLE=true

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info # error | warn | info | debug | trace
LOG_FORMAT=json # json | pretty
LOG_TO_FILE=false
LOG_FILE_PATH=./logs/app.log

# ============================================
# MONITORING
# ============================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Prometheus Metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# ============================================
# SECURITY
# ============================================
BCRYPT_ROUNDS=10
API_KEY_PREFIX=sk_live_ # or sk_test_ for testing

# ============================================
# QUOTAS (Default per user)
# ============================================
DEFAULT_MONTHLY_JOB_QUOTA=100
DEFAULT_MONTHLY_COST_LIMIT_USD=50

# ============================================
# FEATURES FLAGS
# ============================================
FEATURE_OAUTH_ENABLED=true
FEATURE_WEBSOCKET_ENABLED=true
FEATURE_COST_TRACKING_ENABLED=true
